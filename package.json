{
  "name": "am-clinica",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 3000 --hostname 0.0.0.0",
    "dev:open": "sh ./scripts/dev-open.sh",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 next build",
    "start": "next start",
    "lint": "eslint",
    "lint:changed": "node scripts/lint-changed.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "npm run test:unit",
    "test:unit": "tsx --test lib/*.test.ts",
    "test:mcp": "tsx --test mcp/am-clinica/core.test.ts",
    "audit:dead-code": "knip --dependencies --no-exit-code",
    "audit:secrets": "node scripts/gitleaks-tracked.mjs",
    "audit:secrets:history": "gitleaks git . --redact --no-banner",
    "test:finanzas": "tsx --test lib/financial-engine.test.ts lib/payroll-rules.test.ts lib/dashboard.test.ts",
    "test:admission-mobile": "playwright test tests/admission-mobile.spec.ts",
    "drive:simulate": "node scripts/drive-watcher.js",
    "drive:organize": "node scripts/drive-watcher.js --organize",
    "drive:watch": "node scripts/drive-watcher.js --watch",
    "agent:admin": "tsx scripts/am-admin-agent.ts",
    "mcp:am-clinica": "tsx mcp/am-clinica/server.ts",
    "test:mcp:am-clinica": "tsx --test mcp/am-clinica/core.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@google/genai": "^1.52.0",
    "@imgly/background-removal": "^1.7.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@notionhq/client": "^5.6.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.112.3",
    "@types/papaparse": "^5.5.2",
    "@types/three": "^0.183.1",
    "@types/web-push": "^3.6.4",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "fabric": "^7.4.0",
    "framer-motion": "^12.26.2",
    "googleapis": "^171.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "kbar": "^1.0.0",
    "lucide-react": "^0.562.0",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.3",
    "pg": "^8.21.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-image-crop": "^11.0.10",
    "react-markdown": "^10.1.0",
    "recharts": "^3.7.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.20.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "three": "^0.183.1",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@react-email/components": "^1.0.10",
    "@react-email/render": "^2.0.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.35",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "knip": "^6.32.2",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
